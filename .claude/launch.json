{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Sphinx Docs (autobuild)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "sphinx_autobuild", "docs", "docs/_build/html", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "Test Suite (pytest)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "pytest", "tests/", "-v"],
      "port": 0
    }
  ]
}
